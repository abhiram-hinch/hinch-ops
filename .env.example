# Frontend. Anything VITE_-prefixed is bundled and PUBLIC. Anon key only.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# NEVER put the service role key or any Zoho credential in this file.
# Those go in Supabase secrets:  supabase secrets set ZOHO_CLIENT_ID=...
