# Frontend. Anything VITE_-prefixed is bundled and PUBLIC. Anon key only.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Also public once built — restrict it by HTTP referrer in Google Cloud
# Console (your Pages domain + local dev origin), same idea as the anon key.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# NEVER put the service role key or any Zoho credential in this file.
# Those go in Supabase secrets:  supabase secrets set ZOHO_CLIENT_ID=...
