# Local function testing only. Copy to .env.local and fill in.
# This file is gitignored. These values NEVER go in the frontend .env.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
ZOHO_WEBHOOK_SECRET=localdevsecret

# New-order WhatsApp alerts (optional — a no-op unless all three are set)
PERISKOPE_API_KEY=
PERISKOPE_GROUP_CHAT_ID=
DASHBOARD_URL=https://hinch-ops.pages.dev
# PERISKOPE_PHONE=919876543210   # the connected number; Periskope treats it as optional for group chats
